---
import type { BlogArticle } from "../../data/blog";
const { article, headingLevel = "h2" } = Astro.props as {
  article: BlogArticle;
  headingLevel?: "h2" | "h3";
  featured?: boolean;
  compact?: boolean;
};
const Heading = headingLevel;
const formattedDate = new Intl.DateTimeFormat('uk-UA', {day: 'numeric', month: 'long', year: 'numeric'}).format(new Date(`${article.publishedAt}T12:00:00Z`));
---

<article
  class="tc-article-card"
  data-rise
  data-article-title={article.title.toLowerCase()}
  data-article-category={article.category}
>
  <a href={`/blog/${article.slug}/`}>
    <div class="tc-article-card__art">
      <span class="tc-tag">{article.category}</span>
      <span lang="zh" aria-hidden="true">
        {article.marker}
      </span>
      <small>TeaCha</small>
    </div>
    <div class="tc-article-card__meta">
      <time datetime={article.publishedAt}>{formattedDate}</time>
      <span>{article.readTime} хв читання</span>
    </div>
    <Heading>{article.title}</Heading>
    <p>{article.excerpt}</p>
  </a>
</article>
