---
import { siteText } from "../../data/siteText";
const { compact = false } = Astro.props;
const c = siteText.shared.contact;
---

<div
  class:list={["tc-socials", compact && "tc-socials--compact"]}
  aria-label="TeaCha у соцмережах"
>
  <a
    class="tc-social tc-social--instagram"
    href={c.instagramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="TeaCha в Instagram"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5.5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none" />
    </svg>
    <span>Instagram</span>
  </a>
  <a
    class="tc-social tc-social--tiktok"
    href={c.tiktokUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="TeaCha в TikTok"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M16.7 2.5c.3 2.5 1.7 4 4.3 4.2v3.1a8.6 8.6 0 0 1-4.3-1.3v7.1a6.1 6.1 0 1 1-5.3-6v3.2a3 3 0 1 0 2.1 2.8V2.5h3.2Z" />
    </svg>
    <span>TikTok</span>
  </a>
</div>
