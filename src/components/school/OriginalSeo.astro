---
import pages from "../../data/preservedSeo.json";
const pathname = Astro.url.pathname;
const route = /^\/404\/?$/.test(pathname) ? "/404.html" : pathname === "/" || pathname.endsWith(".html") ? pathname : pathname.replace(/\/?$/, "/");
const page = pages[route as keyof typeof pages];
if (!page) throw new Error(`No preserved SEO for ${route}`);
---
<title>{page.title}</title>
{page.meta.map((attributes) => <meta {...attributes} />)}
{page.links.map((attributes) => <link {...attributes} />)}
{page.schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
