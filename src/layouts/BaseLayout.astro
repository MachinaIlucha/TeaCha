---
/**
 * TeaCha website
 * Design & development: Ілля Пінчук Вадимович
 * © 2026. All rights reserved.
 */

import "../styles/main.scss";
import "../styles/school.css";
import "../styles/school-brand.css";
import "../styles/school-motion.css";
import "../styles/school-story.css";
import { siteText } from "../data/siteText";
import { resolveAssetPath } from "../data/assetMap";
import faviconAsset from "../assets/img/layout/teacha-language-school-favicon.png";
import favicon32Asset from "../assets/img/layout/teacha-language-school-favicon-32.png";
import favicon16Asset from "../assets/img/layout/teacha-language-school-favicon-16.png";

import OriginalSeo from "../components/school/OriginalSeo.astro";
import Header from "../components/school/Header.astro";
import Footer from "../components/school/Footer.astro";

import ModalConsult from "../components/school/Modal.astro";
import ToastHost from "../components/layout/ToastHost.astro";
import StartLead from "../components/school/Signup.astro";
import Intro from "../components/school/Intro.astro";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";

type JsonLd = Record<string, unknown>;
type BreadcrumbItem = { name: string; href: string };

const {
  reveal = true,
  bodyClass = "",
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogType = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  hreflangs = [],
  breadcrumbs = [],
  jsonLd = [],
} = Astro.props as {
  reveal?: boolean;
  bodyClass?: string;
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  hreflangs?: Array<{ lang: string; href: string }>;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: JsonLd | JsonLd[];
};

const bodyClassName = [bodyClass, isHome ? "page--home" : ""]
  .filter(Boolean)
  .join(" ");
const site = Astro.site ?? new URL("https://teacha.com.ua");
const siteName = siteText.seo.siteName;
const defaultTitle = siteText.seo.defaultTitle;
const defaultDescription = siteText.seo.defaultDescription;
const defaultOgImage = siteText.seo.defaultOgImage;
const logoImage = resolveAssetPath("img/layout/logo.png");
const faviconImage =
  typeof faviconAsset === "string" ? faviconAsset : faviconAsset.src;
const favicon32 =
  typeof favicon32Asset === "string" ? favicon32Asset : favicon32Asset.src;
const favicon16 =
  typeof favicon16Asset === "string" ? favicon16Asset : favicon16Asset.src;
const contact = siteText.shared.contact;

const toAbsoluteUrl = (value: string) => {
  try {
    return new URL(value).toString();
  } catch {
    return new URL(value.replace(/^\/+/, ""), site).toString();
  }
};

const pageTitleRaw = title?.trim() ?? "";
const metaTitle = pageTitleRaw
  ? pageTitleRaw.includes(siteName)
    ? pageTitleRaw
    : `${pageTitleRaw} | ${siteName}`
  : defaultTitle;
const metaDescription = description?.trim() || defaultDescription;
const canonicalUrl = toAbsoluteUrl(canonical ?? pathname);
const resolvedDefaultOgImage = resolveAssetPath(defaultOgImage);
const resolvedOgImage = ogImage
  ? resolveAssetPath(ogImage)
  : resolvedDefaultOgImage;
const ogImageUrl = toAbsoluteUrl(resolvedOgImage);
const robotsContent = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const alternateLinks = hreflangs.map((item) => ({
  hreflang: item.lang,
  href: toAbsoluteUrl(item.href),
}));

const normalizedBreadcrumbs = breadcrumbs.filter(
  (item) => item?.name && item?.href,
);
const breadcrumbTrail = normalizedBreadcrumbs.length
  ? [
      { name: siteText.seo.homeBreadcrumb, href: "/" },
      ...normalizedBreadcrumbs.filter(
        (item) => item.href !== "/" && item.href !== "",
      ),
    ]
  : [];

const siteUrl = site.toString();
const clientTextJson = JSON.stringify(siteText.client).replace(/</g, "\\u003c");

const organizationSchema: JsonLd = {
  "@context": "https://schema.org",
  "@type": ["EducationalOrganization", "LocalBusiness"],
  name: siteName,
  url: siteUrl,
  image: ogImageUrl,
  logo: toAbsoluteUrl(logoImage),
  email: contact.email,
  telephone: contact.phones[0].raw,
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "customer support",
      telephone: contact.phones[0].raw,
      areaServed: "UA",
      availableLanguage: ["uk"],
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "09:00",
      closes: "21:00",
    },
  ],
  sameAs: [contact.instagramUrl, contact.tiktokUrl],
  address: {
    "@type": "PostalAddress",
    addressCountry: "UA",
    addressLocality: contact.city,
    streetAddress: contact.street,
  },
  hasMap: contact.mapUrl,
  priceRange: "₴₴",
  areaServed: [contact.city, contact.country],
};

const websiteSchema: JsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: siteUrl,
  inLanguage: "uk-UA",
};

const webpageSchema: JsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: metaTitle,
  description: metaDescription,
  url: canonicalUrl,
  inLanguage: "uk-UA",
  isPartOf: {
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
  },
};

const breadcrumbSchema: JsonLd | null = breadcrumbTrail.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbTrail.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: toAbsoluteUrl(item.href),
      })),
    }
  : null;

const customJsonLd = (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).filter(
  Boolean,
);
const jsonLdItems = [
  isHome ? organizationSchema : null,
  isHome ? websiteSchema : null,
  webpageSchema,
  breadcrumbSchema,
  ...customJsonLd,
].filter(Boolean);
---

<!doctype html>
<html lang="uk">
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const last = Number(sessionStorage.getItem("teacha-arrival") || 0);
        const replayIntro =
          ["localhost", "127.0.0.1"].includes(location.hostname) &&
          new URLSearchParams(location.search).get("intro") === "1";
        if (
          location.pathname === "/" &&
          (replayIntro || Date.now() - last > 1800000) &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.documentElement.classList.add("tc-arriving");
          window.setTimeout(
            () => document.documentElement.classList.remove("tc-arriving"),
            7000,
          );
        }
        sessionStorage.setItem("teacha-arrival", String(Date.now()));
      } catch {}
    </script>
    <noscript>
      <style>
        html.js [data-reveal="load"] [data-reveal-item],
        html.js [data-reveal-load] [data-reveal-item] {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      </style>
    </noscript>

    <OriginalSeo />
    <script
      type="application/json"
      id="teacha-client-text"
      set:html={clientTextJson}
    ></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,500;1,600;1,700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class={bodyClassName} {...(!reveal ? { "data-reveal-off": "" } : {})}>
    {isHome && <Intro />}
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <StartLead />
    <Footer />

    <ModalConsult />
    <ToastHost />

    <script>
      import "../scripts/school.js";
    </script>
  </body>
</html>
