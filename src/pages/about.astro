---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutStory from "../components/school/AboutStory.astro";
import TestStrip from "../components/school/TestStrip.astro";
import Approach from "../components/school/Approach.astro";
import Reviews from "../components/school/Reviews.astro";
import { siteText } from "../data/siteText";
import { resolveAssetPath as asset } from "../data/assetMap";
const c = siteText.shared.contact;
const crumbs = [{ name: siteText.pages.about.breadcrumb, href: "/about/" }];
---

<BaseLayout
  title={siteText.pages.about.title}
  description={siteText.pages.about.description}
  breadcrumbs={crumbs}
>
  <AboutStory />
  <section class="tc-section tc-program">
    <div class="tc-wrap">
      <div class="tc-prose-grid">
        <div data-rise>
          <p class="tc-kicker">{siteText.sections.teachers.educationAria}</p>
          <h2>{siteText.sections.teachers.heading}</h2>
        </div>
        <div class="tc-prose" data-rise>
          <p>{siteText.pages.about.teamLead}</p>
          <p>{siteText.sections.facts.items[1].text}</p>
        </div>
      </div>
      <div class="tc-program-grid" style="margin-top:50px">
        {siteText.sections.teachers.cards.map((card, i) => (
          <article data-rise>
            <p class="tc-kicker">0{i + 1}</p>
            <h3>{card.text}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Approach />
  <TestStrip />
  <Reviews />
  <section class="tc-section" id="contacts">
    <div class="tc-wrap">
      <div data-rise>
        <p class="tc-kicker">{siteText.shared.footer.contactsLabel}</p>
        <h2>{siteText.pages.about.contactsHeadingTop}<br /><em>{siteText.pages.about.contactsHeadingBottom}</em></h2><p class="tc-large-copy">{siteText.pages.about.contactsLead}</p>
      </div>
      <div class="tc-contact-grid">
        <div data-rise>
          <h3>{siteText.pages.about.contactCardTitle}</h3>
          {c.phones.map((p) => (
            <a href={`tel:${p.raw}`}>{p.label}</a>
          ))}
          <a href={`mailto:${c.email}`}>{c.email}</a>
        </div>
        <div data-rise>
          <h3>{siteText.pages.about.locationCardTitle}</h3>
          <p>{c.street}, {c.city}, {c.country}</p>
          <a
            class="tc-text-link"
            href={c.mapUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {siteText.pages.about.openMap}
          </a>
        </div>
        <div data-rise>
          <h3>{siteText.pages.about.hoursCardTitle}</h3>
          <p>{c.openingHoursLabel}</p>
          <p>{c.openingHoursNote}</p>
        </div>
      </div>
      <iframe
        class="tc-contact-map"
        src={c.mapEmbedUrl}
        title={c.mapTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>
</BaseLayout>
