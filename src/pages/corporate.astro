import BaseLayout from "../layouts/BaseLayout.astro";

import CorporateHero from "../components/pages/corporate/CorporateHero.astro";
import CorporateBenefits from "../components/pages/corporate/CorporateBenefits.astro";
import CorporateClients from "../components/pages/corporate/CorporateClients.astro";

import Process from "../components/sections/Process.astro";
import Faq from "../components/sections/Faq.astro";

import CorporatePriceTable from "../components/pages/corporate/CorporatePriceTable.astro";
import { siteText } from "../data/siteText";
import { buildFaqSchema } from "../data/seoSchemas";

const pageText = siteText.pages.corporate;
const faqItems = siteText.sections.faq.items.corporate;
const jsonLd = [buildFaqSchema(faqItems)];
---

<BaseLayout
  title={pageText.title}
  description={pageText.description}
  breadcrumbs={[{ name: pageText.breadcrumb, href: "/corporate/" }]}
  bodyClass="page-corporate"
  jsonLd={jsonLd}
>
  <CorporateHero className="sectionShell section--a" />
  <CorporateBenefits className="sectionShell section--b" />
  <Process
    className="sectionShell section--a"
    steps={pageText.processSteps}
    footnote={pageText.processFootnote}
  />

  <CorporateClients className="sectionShell section--b" />

  <CorporatePriceTable className="sectionShell section--a" />

  <Faq className="sectionShell section--a" />
</BaseLayout>
