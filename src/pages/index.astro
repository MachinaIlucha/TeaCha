---
import BaseLayout from "../layouts/BaseLayout.astro";
import Partners from "../components/school/Partners.astro";
import TestStrip from "../components/school/TestStrip.astro";
import Hero from "../components/school/Hero.astro";
import Languages from "../components/school/Languages.astro";
import Approach from "../components/school/Approach.astro";
import Founders from "../components/school/Founders.astro";
import SchoolLife from "../components/school/SchoolLife.astro";
import Reviews from "../components/school/Reviews.astro";
import Pricing from "../components/school/Pricing.astro";
import FAQ from "../components/school/FAQ.astro";
import BlogPreview from "../components/school/BlogPreview.astro";
import { siteText } from "../data/siteText";
import { buildFaqSchema } from "../data/seoSchemas";
---

<BaseLayout
  title={siteText.pages.index.title}
  description={siteText.pages.index.description}
  jsonLd={[buildFaqSchema(siteText.sections.faq.items.home)]}
>
  <Hero />
  <Languages />
  <TestStrip />
  <Approach />
  <Founders />
  <SchoolLife />
  <Reviews />
  <Pricing />
  <Partners />
  <BlogPreview />
  <FAQ />
</BaseLayout>
