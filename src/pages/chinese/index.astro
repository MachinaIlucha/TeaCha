import BaseLayout from "../../layouts/BaseLayout.astro";

import LanguageHero from "../../components/sections/LanguageHero.astro";
import ChineseOverview from "../../components/pages/chinese/ChineseOverview.astro";
import ChineseWhy from "../../components/pages/chinese/ChineseWhy.astro";
import ChineseFormat from "../../components/pages/chinese/ChineseFormat.astro";

import Process from "../../components/sections/Process.astro";
import PriceRates from "../../components/pages/price/PriceRates.astro";
import Reviews from "../../components/sections/Reviews.astro";
import Faq from "../../components/sections/Faq.astro";
import ArticleCard from "../../components/blog/ArticleCard.astro";
import { siteText } from "../../data/siteText";
import { resolveAssetPath } from "../../data/assetMap";
import { buildCourseListSchema, buildFaqSchema } from "../../data/seoSchemas";
import { blogArticles } from "../../data/blog";

const base = import.meta.env.BASE_URL;
const pageText = siteText.pages.chinese;
const faqItems = siteText.sections.chineseFaq.chinese;
const jsonLd = [
  buildCourseListSchema(
    siteText.sections.chinesePrograms.items.map((item) => ({
      name: item.title,
      description: item.text,
      path: item.href,
    })),
  ),
  buildFaqSchema(faqItems),
];
---

<BaseLayout
  title={pageText.title}
  description={pageText.description}
  breadcrumbs={[{ name: pageText.breadcrumb, href: "/chinese/" }]}
  bodyClass="page-chinese"
  jsonLd={jsonLd}
>
  <LanguageHero
    className="sectionShell section--a"
    imgSrc={resolveAssetPath("img/hero/chinese/chinese-language-hero.webp")}
    imgAlt={pageText.hero.imgAlt}
    imgLoading="eager"
    imgFetchpriority="high"
    titleParts={pageText.hero.titleParts}
    subtitle={pageText.hero.subtitle}
  />

  <ChineseOverview className="sectionShell section--b" />
  <ChineseWhy className="sectionShell section--b" />
  <Process className="sectionShell section--b" />
  <ChineseFormat className="sectionShell section--a" />

  <PriceRates base={base} className="sectionShell section--b" />
  <section class="articleRelated sectionShell section--a" aria-labelledby="chinese-blog-title">
    <div class="container">
      <div class="articleRelated__head">
        <div>
          <p class="blogEyebrow">База знань TeaCha</p>
          <h2 id="chinese-blog-title">Корисне про китайську</h2>
        </div>
        <a href={`${base}blog/`}>Усі статті <span aria-hidden="true">→</span></a>
      </div>
      <div class="blogGrid blogGrid--related">
        {blogArticles.slice(0, 3).map((article) => <ArticleCard article={article} compact headingLevel="h3" />)}
      </div>
    </div>
  </section>
  <Reviews className="sectionShell section--b section--ink" />
  <Faq className="sectionShell section--b" items={faqItems} />
</BaseLayout>
