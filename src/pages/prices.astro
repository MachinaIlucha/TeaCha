---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/school/PageHero.astro";
import CorporatePricing from "../components/school/CorporatePricing.astro";
import TestStrip from "../components/school/TestStrip.astro";
import Pricing from "../components/school/Pricing.astro";
import FAQ from "../components/school/FAQ.astro";
import SchoolLife from "../components/school/SchoolLife.astro";
import { siteText } from "../data/siteText";
const crumbs = [{ name: siteText.pages.prices.breadcrumb, href: "/prices/" }];
---

<BaseLayout
  title={siteText.pages.prices.title}
  description={siteText.pages.prices.description}
  breadcrumbs={crumbs}
>
  <PageHero
    title={siteText.pages.prices.headingTop}
    accent={siteText.pages.prices.headingBottom}
    lead={siteText.pages.prices.lead}
    crumbs={crumbs}
    cta={false}
  />
  <Pricing />
  <SchoolLife />
  <TestStrip />
  <CorporatePricing />
  <FAQ />
</BaseLayout>
