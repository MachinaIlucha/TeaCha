---
/**
 * TeaCha website
 * Design & development: Ілля Пінчук Вадимович
 * © 2026. All rights reserved.
 */

import BaseLayout from "../../layouts/BaseLayout.astro";
import FAQ from "../../components/school/FAQ.astro";
import { siteText } from "../../data/siteText";
import { testQuestions, LEVELS } from "../../data/testQuestions.js";
import "../../styles/level-quiz.css";

const base = import.meta.env.BASE_URL;

const levels = [
  {
    code: "A1",
    name: "Beginner",
    nameUk: "Початківець",
    desc: "Розумієш та вживаєш прості вирази. Можеш представитись і спілкуватись на базові теми.",
  },
  {
    code: "A2",
    name: "Elementary",
    nameUk: "Елементарний",
    desc: "Спілкуєшся у простих ситуаціях, описуєш своє оточення та найближчі потреби.",
  },
  {
    code: "B1",
    name: "Intermediate",
    nameUk: "Середній",
    desc: "Справляєшся з більшістю ситуацій у подорожах і на роботі, описуєш події та плани.",
  },
  {
    code: "B2",
    name: "Upper-Intermediate",
    nameUk: "Вище середнього",
    desc: "Спілкуєшся вільно й спонтанно, розумієш складні тексти, аргументуєш свою позицію.",
  },
  {
    code: "C1",
    name: "Advanced",
    nameUk: "Просунутий",
    desc: "Гнучко й ефективно використовуєш мову в академічних, соціальних та професійних контекстах.",
  },
];

// One sample task per level: the first question of each band.
const samples = LEVELS.map((level) => testQuestions.find((q) => q.level === level));

// The same answers are published as FAQPage structured data in preservedSeo.json.
const faq = [
  {
    q: "Як безкоштовно визначити рівень англійської мови онлайн?",
    a: "Пройдіть безкоштовний тест TeaCha з 20 питань на граматику, лексику та читання. За 3–5 хвилин ви отримаєте результат за шкалою CEFR від A1 до C1 та персональні рекомендації щодо курсів. Реєстрація не потрібна.",
  },
  {
    q: "Що таке рівні англійської A1, A2, B1, B2, C1?",
    a: "Це рівні шкали CEFR (Common European Framework of Reference): A1 — початківець, A2 — елементарний, B1 — середній, B2 — вище середнього, C1 — просунутий. Вони показують, наскільки вільно ви спілкуєтесь англійською у повсякденних, академічних та професійних ситуаціях.",
  },
  {
    q: "Скільки часу займає тест на рівень англійської?",
    a: "Тест складається з 20 питань і займає приблизно 3–5 хвилин. Часового обмеження немає — відповідайте у власному темпі. Результат з'являється одразу після останнього питання.",
  },
  {
    q: "Чи потрібна реєстрація для тесту на рівень англійської?",
    a: "Ні, реєстрація не потрібна. Тест TeaCha повністю безкоштовний і доступний миттєво без жодних обмежень.",
  },
];
---

<BaseLayout
  title="Тест на рівень англійської онлайн | TeaCha"
  description="Безкоштовний тест на визначення рівня англійської мови від A1 до C1. 20 питань, 3–5 хвилин. Дізнайся свій рівень та отримай рекомендації від TeaCha."
  breadcrumbs={[
    { name: siteText.pages.english.breadcrumb, href: "/english/" },
    { name: "Тест на рівень", href: "/english/test/" },
  ]}
  bodyClass="page-english page-level-test"
>
  <section class="hsk-test" id="hsk-test">
    <div class="tc-wrap">
      <nav class="tc-crumbs" aria-label="Навігаційний ланцюжок">
        <a href="/">Головна</a>
        <span aria-hidden="true">/</span>
        <a href="/english/">{siteText.pages.english.breadcrumb}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Тест на рівень</span>
      </nav>

      <div class="hsk-screen hsk-intro" data-hsk-screen="intro">
        <div class="hsk-intro__copy">
          <p class="tc-kicker"><span class="tc-dot"></span>Безкоштовний тест · Результат одразу</p>
          <h1 class="tc-page-title hsk-sentence">ВИЗНАЧ СВІЙ РІВЕНЬ <em>АНГЛІЙСЬКОЇ</em></h1>
          <p class="hsk-intro__lead">
            Пройди швидкий тест і дізнайся свій приблизний рівень за шкалою
            CEFR&nbsp;— від&nbsp;A1&nbsp;до&nbsp;C1
          </p>
          <div class="hsk-facts hsk-facts--plain">
            <div><strong>20</strong> <span>питань</span></div>
            <div><strong>3–5</strong> <span>хвилин</span></div>
            <div><strong>A1–C1</strong> <span>шкала CEFR</span></div>
          </div>
          <div class="hsk-intro__actions">
            <button class="tc-button" type="button" data-hsk-start>Розпочати тест <span aria-hidden="true">→</span></button>
          </div>
          <noscript><p class="hsk-note">Щоб пройти тест, увімкніть JavaScript у браузері.</p></noscript>
          <p class="hsk-note">
            Тест є орієнтовним інструментом оцінки рівня. Для точного
            визначення рекомендуємо пройти{" "}
            <a href={`${base}english/`}>пробний урок</a> з викладачем.
          </p>
        </div>
        <ol class="hsk-stairs hsk-stairs--names" aria-hidden="true">
          {levels.map((level, i) => (
            <li class="hsk-step" style={`--i:${i}`}>
              <span class="hsk-tile">{level.code}</span>
              <span class="hsk-step__label">{level.name}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="hsk-screen hsk-quiz" data-hsk-screen="quiz" hidden>
        <div class="hsk-quiz__card">
          <div class="hsk-track" data-hsk-track aria-hidden="true"></div>
          <div class="hsk-status">
            <span data-hsk-counter>1 / 20</span>
            <span class="hsk-status__chips">
              <span class="hsk-chip hsk-chip--quiet" data-hsk-type>Grammar</span>
              <span class="hsk-chip" data-hsk-stage>A1</span>
            </span>
          </div>
          <span class="hsk-tile hsk-watermark" data-hsk-watermark aria-hidden="true">01</span>
          <div class="hsk-body" data-hsk-body>
            <p class="hsk-prompt" data-hsk-prompt></p>
            <p class="hsk-question" lang="en" tabindex="-1" data-hsk-question></p>
            <div class="hsk-options" data-hsk-options role="group" aria-label="Варіанти відповідей"></div>
          </div>
          <div class="hsk-controls">
            <button class="tc-button tc-button--outline" type="button" data-hsk-prev>Назад</button>
            <button class="hsk-skip" type="button" data-hsk-skip>Не знаю — пропустити</button>
            <button class="tc-button" type="button" data-hsk-next>Далі</button>
          </div>
          <p class="hsk-keys" aria-hidden="true">Клавіші 1–4 або A–D — вибір, Enter — далі</p>
        </div>
        <p class="visuallyHidden" role="status" data-hsk-live></p>
      </div>

      <div class="hsk-screen hsk-results" data-hsk-screen="results" hidden>
        <div class="hsk-results__hero">
          <div class="hsk-seal" aria-hidden="true"><span data-hsk-seal>B1</span></div>
          <div>
            <p class="tc-kicker"><span class="tc-dot"></span>Ваш результат</p>
            <h2 class="hsk-results__title" tabindex="-1" data-hsk-results-title>Орієнтовний рівень англійської: <em data-hsk-level>B1 — Intermediate</em></h2>
            <p class="hsk-results__desc" data-hsk-level-desc></p>
          </div>
        </div>
        <ol class="hsk-stairs hsk-stairs--result hsk-stairs--names" data-hsk-result-stairs aria-hidden="true">
          {levels.map((level, i) => (
            <li class="hsk-step" style={`--i:${i}`}>
              <span class="hsk-tile">{level.code}</span>
              <span class="hsk-step__label">{level.name}</span>
            </li>
          ))}
        </ol>
        <dl class="hsk-facts">
          <div><dt>правильних</dt><dd data-hsk-score>0</dd></div>
          <div><dt>всього</dt><dd>20</dd></div>
          <div><dt>точність</dt><dd data-hsk-percent>0%</dd></div>
        </dl>
        <h3 class="hsk-results__sub">Результати за рівнями</h3>
        <div class="hsk-levels" data-hsk-levels></div>
        <h3 class="hsk-results__sub hsk-results__sub--next">Що далі?</h3>
        <p class="hsk-note">
          Обери програму, яка підходить саме для твого рівня, або запишись на безкоштовний
          пробний урок — викладач допоможе скласти персональний план навчання.
        </p>
        <div class="hsk-courses" data-hsk-courses></div>
        <div class="hsk-results__actions">
          <button class="tc-button" type="button" data-open-modal>Записатись на пробний урок</button>
          <button class="tc-button tc-button--outline" type="button" data-hsk-review-toggle aria-expanded="false">Переглянути відповіді</button>
          <button class="hsk-skip" type="button" data-hsk-restart>Пройти тест ще раз</button>
        </div>
        <div class="hsk-review" data-hsk-review hidden></div>
      </div>
    </div>
  </section>

  <section class="tc-section hsk-info" aria-label="Про рівні англійської мови CEFR">
    <div class="tc-wrap">
      <div class="tc-section-head" data-rise>
        <div>
          <h2 class="hsk-sentence">ЩО ТАКЕ РІВНІ <em>АНГЛІЙСЬКОЇ І <span class="hsk-keep">CEFR</span>?</em></h2>
          <p class="hsk-info__lead">
            CEFR (Common European Framework of Reference) — загальноєвропейська
            шкала оцінки знань іноземних мов. Вона використовується
            університетами, роботодавцями та мовними школами по всьому світу і
            включає шість рівнів: від A1 до C2.
          </p>
        </div>
      </div>
      <div class="hsk-levels-grid">
        {levels.map(({ code, name, nameUk, desc }) => (
          <article data-rise>
            <span class="hsk-tile" aria-hidden="true">{code}</span>
            <h3>{code} — {name} · {nameUk}</h3>
            <p>{desc}</p>
          </article>
        ))}
      </div>
      <p class="hsk-info__cta" data-rise>
        Визнач свій рівень прямо зараз — пройди безкоштовний тест вище та
        отримай персональні рекомендації від TeaCha щодо найкращого курсу для
        тебе.
      </p>
    </div>
  </section>

  <section class="tc-section hsk-info hsk-info--samples">
    <div class="tc-wrap">
      <div class="tc-section-head" data-rise>
        <div>
          <h2>Приклади завдань <em>із тесту</em></h2>
          <p>По одному завданню на кожен рівень: перевір, що тобі вже знайоме, а відповіді дізнаєшся після проходження.</p>
        </div>
      </div>
      <div class="hsk-samples">
        {samples.map((q) => (
          <article data-rise>
            <p class="hsk-chip">{q.level}</p>
            <h3 lang="en">{q.question}</h3>
            <p class="hsk-prompt">{q.question.includes("___") ? "Оберіть слово, яке підходить у речення:" : "Оберіть правильну відповідь:"}</p>
            <ul lang="en">{q.options.map((option) => <li>{option}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="tc-actions" data-rise><a class="tc-button" href="#hsk-test">Пройти тест <span aria-hidden="true">↑</span></a></div>
    </div>
  </section>

  <section class="tc-section hsk-info">
    <div class="tc-wrap tc-prose-grid">
      <div data-rise><h2>Як працює тест <em>і що далі</em></h2></div>
      <div class="tc-prose" data-rise>
        <p>Тест складається з 20 питань на граматику, лексику та читання: по 4 на кожен рівень від A1 до C1. Рівень зараховується, якщо правильних відповідей щонайменше 3 з 4, а результатом стає найвищий такий рівень.</p>
        <p>Тест не оцінює говоріння й аудіювання, тому результат варто підтвердити з викладачем на <a href="/english/">курсах англійської</a>. На екрані результату ти побачиш розбір відповідей і курси, що підходять твоєму рівню.</p>
      </div>
    </div>
  </section>

  <FAQ items={faq} />

  <script>
    import { initEnglishTest } from "../../scripts/features/englishTest.js";
    initEnglishTest();
  </script>
</BaseLayout>
