---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteText } from '../data/siteText';
const page = siteText.pages.notFound;
---
<BaseLayout title={page.title} description={page.description} noindex>
  <section class="tc-section"><div class="tc-wrap"><p class="tc-kicker">{page.code}</p><h1 class="tc-page-title">{page.heading}</h1><p style="margin:25px 0 35px">{page.text}</p><div class="tc-actions">{page.links.map((link, i) => <a class={i ? 'tc-text-link' : 'tc-button'} href={`/${link.href}`}>{link.label}</a>)}</div></div></section>
</BaseLayout>
