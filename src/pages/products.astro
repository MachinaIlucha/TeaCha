---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/school/PageHero.astro";
import { siteText } from "../data/siteText";
import { resolveAssetPath as asset } from "../data/assetMap";
const photos = [
  ["teacha-first-tshirt-front.webp", "teacha-first-tshirt-back.webp"],
  ["teacha-second-tshirt-front.webp", "teacha-second-tshirt-back.webp"],
  ["teacha-stickers-pack.webp", "teacha-stickers-pack-alt.webp"],
];
---

<BaseLayout
  title={siteText.pages.products.title}
  description={siteText.pages.products.description}
  noindex
>
  <PageHero
    title={siteText.pages.products.headingTop}
    accent={siteText.pages.products.headingBottom}
    crumbs={[{ name: siteText.pages.products.breadcrumb, href: "/products/" }]}
    cta={false}
  />
  <section class="tc-section">
    <div class="tc-wrap">
      <div class="tc-merch-grid">
        {siteText.pages.products.items.map((item, i) => (
          <article class="tc-merch" data-rise>
            <div
              class="tc-merch__photos"
              aria-label={item.galleryAria}
              tabindex="0"
            >
              {photos[i].map((photo, j) => (
                <img
                  src={asset(`img/products/${photo}`)}
                  alt={j ? item.alt2 : item.alt1}
                  loading="lazy"
                  width="600"
                  height="700"
                />
              ))}
            </div>
            <span class="tc-kicker">Гортайте фото ↔</span>
            <h2>{item.name}</h2>
            <div>
              <span>{item.price}</span>
              <a
                class="tc-text-link"
                href={siteText.shared.contact.instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {siteText.shared.forms.trialButton}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
