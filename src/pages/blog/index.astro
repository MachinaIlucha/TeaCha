---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/school/PageHero.astro";
import ArticleCard from "../../components/blog/ArticleCard.astro";
import { blogArticles } from "../../data/blog";
const categories = [...new Set(blogArticles.map((a) => a.category))];
const crumbs = [{ name: "Блог", href: "/blog/" }];
---

<BaseLayout
  title="Блог TeaCha — історії, відкриття та практичні поради про мови"
  description="Китайська з нуля, вимова, HSK, навчання дітей та нові можливості. Корисні матеріали від команди школи TeaCha."
  breadcrumbs={crumbs}
  bodyClass="page-blog"
>
  <PageHero
    title="Китайська"
    accent="без туману"
    eyebrow="База знань TeaCha"
    lead="Розбираємо мову по суті: від першого тону до HSK і робочих переговорів. З прикладами, чесними строками та планами, які можна взяти в навчання сьогодні."
    crumbs={crumbs}
    cta={false}
  />
  <div class="tc-wrap tc-language__tags" aria-label="Теми блогу"><span lang="zh-Hans">学</span><span>вчитися</span><span>HSK 3.0</span><span>Вимова</span><span>Початківцям</span><span>Дітям</span><span>Кар’єра</span></div>
  <section class="tc-section">
    <div class="tc-wrap">
      <div class="tc-section-head" data-rise><div><p class="tc-kicker">Читайте й застосовуйте</p><h2>Усі матеріали</h2></div><p>{blogArticles.length} докладних гайдів про китайську мову</p></div>
      <div class="tc-blog-controls">
        <div class="tc-blog-categories" aria-label="Фільтр за темою">
          <button class="is-active" data-category="all" aria-pressed="true">
            Усі матеріали
          </button>
          {categories.map((c) => (
            <button data-category={c} aria-pressed="false">
              {c}
            </button>
          ))}
        </div>
        <label class="tc-blog-search">
          <input
            type="search"
            placeholder="Що вам цікаво?"
            aria-label="Пошук статей"
            data-blog-search
          />
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 5 5" />
          </svg>
        </label>
      </div>
      <p class="tc-kicker" data-blog-count aria-live="polite">
        Матеріалів: {blogArticles.length}
      </p>
      <div class="tc-article-grid tc-blog-all">
        {blogArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
      <p class="tc-blog-empty" data-blog-empty hidden>
        За цим запитом нічого не знайшлося. Спробуйте іншу тему або коротший
        запит.
      </p>
    </div>
  </section>
</BaseLayout>
